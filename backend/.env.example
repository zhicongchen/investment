# Copy this file to `.env` and fill in your Financial Modeling Prep key.
# The backend reads `.env` automatically on startup.
FMP_API_KEY=

# Optional local Ollama analysis settings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=180

# Price data: `moomoo` (OpenD, falls back to yfinance when OpenD is offline) or `yfinance`.
MARKET_DATA_PROVIDER=moomoo
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# Extra browser origins allowed to call the API (comma-separated). The local dev
# server and https://zhicongchen.github.io are always allowed.
CORS_ORIGINS=
