# Copy this file to `bot/.env` and adjust for your IBKR bot runtime.
BOT_IBKR_HOST=127.0.0.1
BOT_IBKR_PORT=7496
BOT_IBKR_CLIENT_ID=20
BOT_LIVE_TRADING_ENABLED=false
BOT_MAX_ORDER_NOTIONAL_USD=500
BOT_MAX_DAILY_NOTIONAL_USD=2000
BOT_ALLOW_AFTER_HOURS=false
BOT_ALLOW_SHORTS=false
BOT_DUPLICATE_COOLDOWN_SECONDS=900
BOT_LOOP_INTERVAL_SECONDS=300
BOT_DB_PATH=data/ibkr_bot_audit.db
BOT_TICKERS=AAPL,MSFT,SPY
BOT_STRATEGY=noop
BOT_DIP_BUY_NOTIONAL_USD=100
BOT_CORE_ETFS=SPY,VOO,QQQ
BOT_MAX_POSITION_PCT=0.20
BOT_TREND_MA_DAYS=200
BOT_DIP_LOOKBACK_DAYS=20
BOT_DIP_MIN_PULLBACK_PCT=0.03
BOT_LIMIT_DISCOUNT_PCT=0.0025
